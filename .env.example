# Plantilla sin valores. Copia a .env y llena localmente. Nunca subir .env.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLERK_API_KEY=            # clave publicable (pk_...)
CLERK_SECRET_KEY=
CLAUDE_KEY=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Llamadas reales (etapa B). Todo apagado por defecto: con VOICE=fake nunca se llama a nadie.
# RETELL_API_KEY tambien firma los webhooks (debe ser una llave con permiso de webhook).
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_ID_FABRICANTE=
RETELL_FROM_NUMBER=
CALLS_WAVE=3
QUOTE_MODEL=claude-sonnet-5-5
RETELL_AGENT_ID_AGENDA=
# Reglas de llamadas (valores por defecto entre parentesis): CALLS_WINDOW_ENABLED (hoy false = 24 horas, solo para pruebas; ANTES DE PRODUCCION true = lunes a sabado 9 a 19 hora de Mexico),
# CALLS_RETRY_AFTER_MIN (120), REQUEST_TTL_HOURS (24), MAX_COST_PER_REQUEST_USD (3), MAX_COST_PER_DAY_USD (15)
